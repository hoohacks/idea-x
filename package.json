{
  "name": "idea-x",
  "version": "0.1.0",
  "homepage": "https://hoohacks.github.io/idea-x",
  "private": false,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.10.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "chart.js": "^4.4.0",
    "dotenv": "^16.0.3",
    "firebase": "^9.9.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "^5.0.1",
    "react-zxing": "^2.1.0",
    "reactjs-popup": "^2.0.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "cross-env REACT_APP_REGISTRATION_OPEN=true react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false",
    "test:rules": "firebase emulators:exec --only database --project demo-ideathon \"vitest run --config vitest.rules.config.mjs\"",
    "test:rules:watch": "vitest --config vitest.rules.config.mjs",
    "emulators": "firebase emulators:start --only database,auth,storage --project demo-ideathon",
    "rules:cutover": "node scripts/make-cutover-rules.mjs",
    "migrate:members": "node scripts/migrate-team-members.mjs",
    "migrate:scores": "node scripts/migrate-scores.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "eject": "react-scripts eject",
    "start:emulator": "cross-env REACT_APP_USE_EMULATOR=true REACT_APP_REGISTRATION_OPEN=true react-scripts start",
    "seed": "node scripts/seed-event.mjs",
    "test:e2e": "firebase emulators:exec --only database,auth,storage --project demo-ideathon \"node scripts/seed-event.mjs --teams=8 --judges=12 --rooms=8 --schedule && playwright test\"",
    "test:e2e:ui": "playwright test --ui"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^2.0.7",
    "@playwright/test": "^1.62.1",
    "cross-env": "^7.0.3",
    "firebase-tools": "^13.29.1",
    "gh-pages": "^4.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
