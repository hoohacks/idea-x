rules_version = '2';

// Cloud Storage rules. Paste into the Firebase console (Storage -> Rules) or
// deploy with `firebase deploy --only storage`.
//
// Note on download URLs: getDownloadURL() returns a URL carrying an access
// token, and that token grants access regardless of these rules. So anyone
// holding a resume or pitch deck link can open it whether or not `read` is
// allowed below. Treat the links themselves as the secret.
service firebase.storage {
  match /b/{bucket}/o {

    // Resumes are picked and uploaded on the public registration form, before
    // the person has an account, so this cannot require auth. That means an
    // anonymous write endpoint, which is why it is capped hard and pinned to
    // document types. See docs/decisions/0006 for the alternative.
    //
    // The event year is a path segment rather than part of the folder name.
    // The old rule hardcoded /ideathon-resume-2025/, while the form uploads to
    // the current EVENT.year -- so every upload this year would have been
    // rejected, and the form would have quietly registered people without the
    // resume they attached.
    match /ideathon-resumes/{eventYear}/{gradYear}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/msword')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*'));
    }

    // Resumes uploaded under the old layout, kept readable for admins.
    match /ideathon-resume-2025/{gradYear}/{fileName} {
      allow read: if request.auth != null;
    }

    // Pitch decks, uploaded from the team page by a signed-in member.
    //
    // The uploader's uid is a path segment because Storage rules cannot query
    // the Realtime Database -- there is no way to ask "is this person on this
    // team" from here. Without it, `request.auth != null` was the only
    // condition on the write, so any signed-in account could overwrite any
    // team's deck given the team id and the file name. Scoping the write to
    // the uploader's own segment closes that without blocking someone
    // replacing their own file, which create-only would have done.
    match /teams/{teamId}/{uploaderUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uploaderUid
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('application/vnd.ms-powerpoint')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
                       || request.resource.contentType.matches('application/pdf'));
    }

    // Decks uploaded under the old flat layout. Readable so existing
    // submissions keep working; no longer writable.
    match /teams/{teamId}/{fileName} {
      allow read: if request.auth != null;
    }

    // Nothing else is writable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
